r", "el cargador", 480, 460, "My phone charger is in the living room."]]}, {"id": "bathroom", "n": 3, "title": "The bathroom", "es": "El baño", "scene": "bathroom", "deck": "Small room, many words. Learn them before you need them.", "words": [["toilet", "el inodoro", 130, 330, "The toilet is not working."], ["sink", "el lavabo", 300, 330, "Wash your hands in the sink."], ["mirror", "el espejo", 300, 180, "Look in the mirror and comb your hair."], ["shower", "la ducha / la regadera", 560, 180, "Take a shower before school."], ["bathtub", "la bañera / la tina", 620, 400, "The baby takes a bath in the bathtub."], ["towel", "la toalla", 860, 180, "Dry your hands with the towel."], ["toothbrush", "el cepillo de dientes", 420, 240, "Bring your toothbrush on the trip."], ["toothpaste", "la pasta de dientes", 470, 290, "We are out of toothpaste."], ["soap", "el jabón", 860, 330, "Use soap, not just water."], ["shampoo", "el champú", 940, 420, "This shampoo smells like coconut."], ["toilet paper", "el papel higiénico", 130, 470, "Please buy toilet paper."], ["comb", "el peine", 860, 470, "I lost my comb."]]}, {"id": "transport", "n": 4, "title": "Transportation", "es": "El transporte", "scene": "transport", "deck": "How you get there, and what to say at the window.", "words": [["car", "el carro / el coche", 150, 290, "My uncle drives a red car."], ["truck", "el camión", 400, 280, "The truck carries the lumber."], ["bicycle", "la bicicleta", 640, 300, "I ride my bicycle to school."], ["motorcycle", "la motocicleta", 850, 290, "A motorcycle is loud."], ["bus", "el autobús", 300, 480, "The bus stops at the corner."], ["train", "el tren", 700, 480, "The train goes to New Orleans."], ["airplane", "el avión", 200, 110, "We came to Mississippi by airplane."], ["taxi", "el taxi", 560, 160, "Call a taxi to the airport."], ["boat", "el barco / la lancha", 860, 150, "My grandfather fished from a boat."], ["helmet", "el casco", 120, 190, "Wear a helmet on the bicycle."], ["seat belt", "